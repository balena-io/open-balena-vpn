#!/command/with-contenv bash

set -euo pipefail

# Redirect all future stdout/stderr to s6-log
exec > >(exec s6-log p"vpn[$$]:" 1 || true) 2>&1

# Change to working directory
cd /usr/src/app || exit 1

# Start in the foreground with exec to pass signals through.
# config/env values override the container env.
exec /command/envfile config/env /etc/s6-overlay/scripts/start.sh
