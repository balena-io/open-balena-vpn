#!/usr/bin/env bash

set -euo pipefail

# Redirect all future stdout/stderr to s6-log
exec > >(exec s6-log p"node-exporter[$$]:" 1 || true) 2>&1

exec /usr/local/bin/node_exporter \
    --web.listen-address 127.0.0.1:9000 \
    --web.telemetry-path /metrics/node \
    --collector.disable-defaults \
    --collector.netstat
