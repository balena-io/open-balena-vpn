{{- $val := getenv "ROOT_CA" -}}
{{- $parts := split $val "-----" -}}
{{- if and (gt (len $parts) 1) (eq (index $parts 0) "") -}}
  {{- $val -}}
{{- else -}}
  {{- base64Decode $val -}}
{{- end -}}
{{- $val := getenv "VPN_OPENVPN_CA_CRT" -}}
{{- $parts := split $val "-----" -}}
{{- if and (gt (len $parts) 1) (eq (index $parts 0) "") -}}
  {{- $val -}}
{{- else -}}
  {{- base64Decode $val -}}
{{- end -}}
