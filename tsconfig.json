{
	"compilerOptions": {
		"allowJs": false,
		"forceConsistentCasingInFileNames": true,
		"lib": ["es2025"],
		"module": "NodeNext",
		"noErrorTruncation": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "build/",
		"preserveConstEnums": true,
		"removeComments": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"useUnknownInCatchVariables": false,
		"target": "es2025"
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"src/**/*.ts"
	]
}
